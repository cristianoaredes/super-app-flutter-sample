#!/usr/bin/env bash
# cbops — thin-client: resolve o motor e executa um módulo NELE (TCK-2821 f1).
# Nada de lib/ copiada: o engine.pyz é o único transportador do código.
# Uso: bash scripts/hooks/cbops <modulo> [args...]   ex.: cbops cbctl --help
set -euo pipefail
[ $# -ge 1 ] || { echo "uso: cbops <modulo> [args...]" >&2; exit 2; }
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ENGINE="$(python3 "$ROOT/.orqo/resolve-engine.py" --root "$ROOT")"
# TCK-0128: o engine resolve a raiz a partir de ONDE ELE MORA — dentro de
# `.orqo/`. Sem esta exportação, `cbops ops/ticket/create` cria o ticket em
# `.orqo/.archagents/`, e o `.archagents/` do projeto fica vazio.
#
# Medido no mcp-senado: o primeiro comando após o bootstrap escreveu no lugar
# errado. O engine AVISA ("você está em X mas este script opera sobre X/.orqo"),
# mas aviso que não impede é aviso que se lê depois do estrago — e o estrago
# aqui é o estado do projeto nascer num diretório que ninguém versiona.
export CBOPS_REPO_ROOT="${CBOPS_REPO_ROOT:-$ROOT}"
exec python3 "$ENGINE" --module "$@"
